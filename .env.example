# "tse" (padrão) = dados oficiais ao vivo | "simulacao" = apuração fictícia gerada localmente
DATA_MODE=tse

# Segundos de cache no servidor para cada arquivo do TSE (revalida com ETag; não use menos de 3)
TSE_CACHE_TTL=4

# Códigos de eleição — 1º turno 04/10/2026. Para o 2º turno (25/10) use 6258 e 6260 (confira o campo cdt2 do ele-c.json).
TSE_BASE=https://resultados.tse.jus.br/oficial
TSE_CICLO=ele2026
TSE_ELEICAO_FEDERAL=6257
TSE_ELEICAO_ESTADUAL=6259

# Duração da apuração simulada, em segundos (só no modo simulacao)
DEMO_DURACAO_S=480

# Redis compartilhado (Upstash for Redis no Marketplace da Vercel) — guarda o mapa de municípios
# para todas as instâncias do servidor. Sem isso funciona só em memória (cada instância recomeça do zero).
# A integração da Vercel cria estas variáveis sozinha:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
